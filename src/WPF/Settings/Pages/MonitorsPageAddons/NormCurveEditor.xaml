<UserControl
    x:Class="BrightnessTrayAppWPF.WPF.Settings.Pages.MonitorsPageAddons.NormCurveEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    Focusable="True"
    IsTabStop="True"
    PreviewMouseWheel="OnPreviewMouseWheel">

    <Border CornerRadius="{DynamicResource CornerRadiusLarge}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Y-axis label gutters flank the plot, mirroring CurveEditor's layout
                     so the editor inherits its readability without restyling. -->
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>

            <Canvas x:Name="ValueLabelCanvas"
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    SnapsToDevicePixels="True"/>

            <!-- Plot area: gridlines, polyline, and control-point thumbs.
                 SizeChanged drives a redraw so the curve rescales with its host. -->
            <Canvas x:Name="PlotCanvas"
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Transparent"
                    SnapsToDevicePixels="True"
                    ClipToBounds="False"
                    SizeChanged="PlotCanvas_SizeChanged"
                    MouseLeftButtonDown="PlotCanvas_MouseLeftButtonDown"
                    MouseRightButtonDown="PlotCanvas_MouseRightButtonDown"
                    MouseMove="PlotCanvas_MouseMove"
                    MouseLeftButtonUp="PlotCanvas_MouseLeftButtonUp"
                    MouseEnter="PlotCanvas_MouseEnter"
                    MouseLeave="PlotCanvas_MouseLeave"/>

            <!-- Cursor-readout overlay layer. Holds persistent elements
                 (scrubber line, readout pill, curve marker + label)
                 whose positions are mutated directly without touching the heavy Redraw path.
                 Hit-test transparent so input falls through to PlotCanvas underneath. -->
            <Canvas x:Name="OverlayCanvas"
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Transparent"
                    SnapsToDevicePixels="True"
                    ClipToBounds="True"
                    IsHitTestVisible="False"/>

            <Canvas x:Name="ValueLabelCanvasRight"
                    Grid.Row="0"
                    Grid.Column="2"
                    Background="Transparent"
                    SnapsToDevicePixels="True"/>

            <!-- X-axis labels strip: 0..100 in even divisions. Sits below the plot
                 to match the time-axis layout the host CurveEditor uses. -->
            <Canvas x:Name="XLabelCanvas"
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="Transparent"
                    SnapsToDevicePixels="True"/>
        </Grid>
    </Border>
</UserControl>
