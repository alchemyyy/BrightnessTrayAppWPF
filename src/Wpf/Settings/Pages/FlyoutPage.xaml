<UserControl
    x:Class="BrightnessTrayAppWpf.Wpf.Settings.Pages.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BrightnessTrayAppWpf.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:BrightnessTrayAppWpf.Wpf.Settings.Utils"
    xmlns:utils1="clr-namespace:BrightnessTrayAppWpf.Wpf.Utils"
    mc:Ignorable="d"
    d:DesignWidth="660"
    d:DesignHeight="594"
    d:Background="#1F1F1F"
    utils1:SettingsKeyboardNavigation.IsContentSection="True">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Flyout"/>

        <utils:SettingsCard Title="Restore undock state on startup"
                            Description="When the app launches, restore the flyout's docked or undocked state from the previous session. When off, the flyout always opens docked.">
          <utils:SettingsCard.Control>
            <CheckBox x:Name="RestoreFlyoutUndockedOnStartupToggle"
                      Style="{StaticResource ToggleSwitchStyle}"
                      Tag="RestoreFlyoutUndockedOnStartup" Checked="BoolToggle_Changed"
                      Unchecked="BoolToggle_Changed"/>
          </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="Visibility"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="Show undock button"
                               Description="Show the undock button in the flyout. When off, the flyout always stays anchored to the tray.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="AllowFlyoutUndockToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="AllowFlyoutUndock" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Show monitor power buttons"
                               Description="Display a per-monitor power off button next to each monitor in the brightness flyout.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowFlyoutMonitorPowerToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowFlyoutMonitorPowerButtons" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Show display number on monitor icons"
                               Description="Overlay the OS-assigned display number inside each monitor icon in the brightness flyout.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowFlyoutMonitorNumberBadgeToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowFlyoutMonitorNumberBadge" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Show display settings button"
                               Description="Show the link to Windows display settings in the brightness flyout footer.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowFlyoutDisplaySettingsButtonToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowFlyoutDisplaySettingsButton" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Show power button"
                               Description="Show a power button in the brightness flyout footer.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowFlyoutFooterPowerButtonToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowFlyoutFooterPowerButton" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Show master slider"
                               Description="Show the All Displays master slider in the brightness flyout.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowMasterSliderToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowMasterSlider" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Show individual sliders"
                               Description="Show the per-monitor sliders in the brightness flyout.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowIndividualSlidersToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowIndividualSliders" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Show environmental curves button"
                               Description="Show the environmental curves toggle button in the brightness flyout footer.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowEnvironmentalCurvesButtonToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowEnvironmentalCurvesButton" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Show kelvin label on night light slider"
                               Description="Display the current color temperature (e.g. 4500K) above the night light slider in the brightness flyout.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowNightLightKelvinLabelToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowNightLightKelvinLabel" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="Behavior"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="Power button affects only enabled monitors"
                               Description="When on, the footer power button only powers off monitors enabled in the app. When off, it powers off every monitor.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="FooterPowerButtonOnlyEnabledToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="FooterPowerButtonOnlyEnabledMonitors" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Number keys switch profile in flyout"
                               Description="While the brightness flyout is focused, press 1-4 to switch to the matching profile.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="FlyoutNumberKeysSwitchProfileToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="FlyoutNumberKeysSwitchProfile" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Master slider tracking"
                               Description="How the master slider reflects the individual monitor sliders when it's not driving them.">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="MasterSliderModeCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="MasterSliderMode" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="Lowest">Lowest</ComboBoxItem>
                    <ComboBoxItem Tag="Average">Average</ComboBoxItem>
                    <ComboBoxItem Tag="Highest">Highest</ComboBoxItem>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Preserve slider offsets (prevent slider offset degeneration)"
                               Description="When the master slider pushes an individual monitor past 0% or 100%, retain the overflow so later master adjustments restore the original brightness differences between monitors.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="PreserveMasterSliderOffsetsToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="PreserveMasterSliderOffsets" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Mouse wheel step"
                               Description="How many percent each mouse wheel notch adjusts a brightness slider in the flyout.">
            <utils:SettingsCard.Control>
                <local:NumericSpinner Width="100" VerticalAlignment="Center"
                                      x:Name="FlyoutScrollWheelStepBox"
                                      Suffix="%"
                                      Minimum="1" Maximum="50"
                                      ExtraLargeStep="50"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>
    </StackPanel>
</UserControl>
