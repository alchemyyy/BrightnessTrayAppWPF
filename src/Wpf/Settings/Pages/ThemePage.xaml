<UserControl
    x:Class="BrightnessTrayAppWpf.Wpf.Settings.Pages.ThemePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:BrightnessTrayAppWpf.Localization"
    xmlns:models="clr-namespace:BrightnessTrayAppWpf.Models"
    xmlns:utils="clr-namespace:BrightnessTrayAppWpf.Wpf.Settings.Utils"
    xmlns:utils1="clr-namespace:BrightnessTrayAppWpf.Wpf.Utils"
    mc:Ignorable="d"
    d:DesignWidth="660"
    d:DesignHeight="594"
    d:Background="#1F1F1F"
    utils1:SettingsKeyboardNavigation.IsContentSection="True">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_Theme_SectionHeader}"/>

        <TextBlock Text="{loc:Loc Settings_Theme_ContextMenu_Header}"
                   Style="{StaticResource SettingTitleStyle}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_FontSize_Title}"
                               Description="{loc:Loc Settings_Theme_FontSize_Description}">
            <utils:SettingsCard.Control>
                <TextBox x:Name="ContextMenuFontSizeBox"
                         Style="{StaticResource SettingsTextBoxStyle}"
                         Width="80"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         PreviewTextInput="DigitsOnly_PreviewTextInput"
                         LostFocus="ContextMenuFontSize_LostFocus"
                         KeyDown="ContextMenuFontSize_KeyDown"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="{loc:Loc Settings_Theme_Appearance_Header}"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_ThemeStyle_Title}"
                               Description="{loc:Loc Settings_Theme_ThemeStyle_Description}">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="ThemeModeCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="ThemeMode" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="System" Content="{loc:Loc Settings_Theme_ThemeStyle_System}"/>
                    <ComboBoxItem Tag="Light" Content="{loc:Loc Settings_Theme_ThemeStyle_Light}"/>
                    <ComboBoxItem Tag="Dark" Content="{loc:Loc Settings_Theme_ThemeStyle_Dark}"/>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_TextColor_Title}"
                               Description="{loc:Loc Settings_Theme_TextColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="TextColorLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="Text|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_TextColor_LightTooltip}"/>
                    <Button x:Name="TextColorDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="Text|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_TextColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="Text" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_BackgroundColor_Title}"
                               Description="{loc:Loc Settings_Theme_BackgroundColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="BackgroundColorLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="Background|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_BackgroundColor_LightTooltip}"/>
                    <Button x:Name="BackgroundColorDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="Background|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_BackgroundColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="Background" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="{loc:Loc Settings_Theme_Flyout_Header}"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_RoundedCorners_Title}"
                               Description="{loc:Loc Settings_Theme_RoundedCorners_Description}">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="RoundedCornersToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="EnableRoundedCorners" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_SliderIndicator_Title}"
                               Description="{loc:Loc Settings_Theme_SliderIndicator_Description}">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="SliderThumbGlyphCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          SelectionChanged="SliderThumbGlyph_Changed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SliderThumbGlyphOption}">
                            <StackPanel Orientation="Horizontal"
                                        d:DataContext="{d:DesignInstance Type=models:SliderThumbGlyphOption}">
                                <Grid Width="22" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="{Binding FontFamily}"
                                               FontSize="{Binding FontSize}"
                                               Width="{Binding Width}"
                                               Height="{Binding Height}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Visibility="{Binding IsGlyph, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding XScale}" ScaleY="1"/>
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>
                                    <Border Width="{Binding Width}"
                                            Height="{Binding Height}"
                                            CornerRadius="{DynamicResource CornerRadiusCapsule}"
                                            Background="{DynamicResource ThemeForeground}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsCapsule, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="{loc:Loc Settings_Theme_TrayIcon_Header}"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_TrayIconStyle_Title}"
                               Description="{loc:Loc Settings_Theme_TrayIconStyle_Description}">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayIconStyleCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayIconStyle" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="Dynamic" Content="{loc:Loc Settings_Theme_TrayIconStyle_Dynamic}"/>
                    <ComboBoxItem Tag="Static" Content="{loc:Loc Settings_Theme_TrayIconStyle_Static}"/>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_DynamicIconTracking_Title}"
                               Description="{loc:Loc Settings_Theme_DynamicIconTracking_Description}">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="DynamicIconBrightnessTrackingCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="DynamicIconBrightnessTracking" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="Lowest" Content="{loc:Loc Settings_Theme_DynamicIconTracking_Lowest}"/>
                    <ComboBoxItem Tag="Average" Content="{loc:Loc Settings_Theme_DynamicIconTracking_Average}"/>
                    <ComboBoxItem Tag="Highest" Content="{loc:Loc Settings_Theme_DynamicIconTracking_Highest}"/>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_TrackEnabledOnly_Title}"
                               Description="{loc:Loc Settings_Theme_TrackEnabledOnly_Description}">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="DynamicIconTrackEnabledOnlyToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="DynamicIconTrackEnabledOnly" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard x:Name="TrayIconStaticColorCard"
                               Title="{loc:Loc Settings_Theme_StaticIconColor_Title}"
                               Description="{loc:Loc Settings_Theme_StaticIconColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="TrayIconColorLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIcon|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_StaticIconColor_LightTooltip}"/>
                    <Button x:Name="TrayIconColorDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIcon|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_StaticIconColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="TrayIcon" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard x:Name="TrayIconBrightColorCard"
                               Title="{loc:Loc Settings_Theme_BrightColor_Title}"
                               Description="{loc:Loc Settings_Theme_BrightColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="TrayIconBrightColorLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIconBright|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_BrightColor_LightTooltip}"/>
                    <Button x:Name="TrayIconBrightColorDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIconBright|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_BrightColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="TrayIconBright" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard x:Name="TrayIconDimColorCard"
                               Title="{loc:Loc Settings_Theme_DimColor_Title}"
                               Description="{loc:Loc Settings_Theme_DimColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="TrayIconDimColorLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIconDim|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_DimColor_LightTooltip}"/>
                    <Button x:Name="TrayIconDimColorDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIconDim|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_DimColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="TrayIconDim" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="{loc:Loc Settings_Theme_Environmental_Header}"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_BrightnessCurveColor_Title}"
                               Description="{loc:Loc Settings_Theme_BrightnessCurveColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvBrightnessCurveLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvBrightnessCurve|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_BrightnessCurveColor_LightTooltip}"/>
                    <Button x:Name="EnvBrightnessCurveDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvBrightnessCurve|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_BrightnessCurveColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="EnvBrightnessCurve" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_NightLightCurveColor_Title}"
                               Description="{loc:Loc Settings_Theme_NightLightCurveColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvNightLightCurveLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvNightLightCurve|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_NightLightCurveColor_LightTooltip}"/>
                    <Button x:Name="EnvNightLightCurveDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvNightLightCurve|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_NightLightCurveColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="EnvNightLightCurve" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_CurrentTimeMarkerColor_Title}"
                               Description="{loc:Loc Settings_Theme_CurrentTimeMarkerColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvCurrentTimeLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvCurrentTime|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_CurrentTimeMarkerColor_LightTooltip}"/>
                    <Button x:Name="EnvCurrentTimeDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvCurrentTime|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_CurrentTimeMarkerColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="EnvCurrentTime" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_TwilightBackdropColor_Title}"
                               Description="{loc:Loc Settings_Theme_TwilightBackdropColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvTwilightBackdropLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvTwilightBackdrop|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_TwilightBackdropColor_LightTooltip}"/>
                    <Button x:Name="EnvTwilightBackdropDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvTwilightBackdrop|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_TwilightBackdropColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="EnvTwilightBackdrop" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_NightBackdropColor_Title}"
                               Description="{loc:Loc Settings_Theme_NightBackdropColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvNightBackdropLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvNightBackdrop|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_NightBackdropColor_LightTooltip}"/>
                    <Button x:Name="EnvNightBackdropDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvNightBackdrop|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_NightBackdropColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="EnvNightBackdrop" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Theme_GridLineColor_Title}"
                               Description="{loc:Loc Settings_Theme_GridLineColor_Description}">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvGridLineLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvGridLine|Light" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_GridLineColor_LightTooltip}"/>
                    <Button x:Name="EnvGridLineDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvGridLine|Dark" Click="ColorSwatch_Click"
                            ToolTip="{loc:Loc Settings_Theme_GridLineColor_DarkTooltip}"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{loc:Loc Settings_Theme_Reset}"
                            Tag="EnvGridLine" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>
    </StackPanel>
</UserControl>
