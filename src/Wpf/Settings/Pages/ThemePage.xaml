<UserControl
    x:Class="BrightnessTrayAppWpf.Wpf.Settings.Pages.ThemePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:BrightnessTrayAppWpf.Models"
    xmlns:utils="clr-namespace:BrightnessTrayAppWpf.Wpf.Settings.Utils"
    xmlns:utils1="clr-namespace:BrightnessTrayAppWpf.Wpf.Utils"
    mc:Ignorable="d"
    d:DesignWidth="660"
    d:DesignHeight="594"
    d:Background="#1F1F1F"
    utils1:SettingsKeyboardNavigation.IsContentSection="True">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Theme"/>

        <TextBlock Text="Context menu"
                   Style="{StaticResource SettingTitleStyle}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <utils:SettingsCard Title="Font size"
                               Description="Controls the overall size of the tray context menu. All elements scale from font size.">
            <utils:SettingsCard.Control>
                <TextBox x:Name="ContextMenuFontSizeBox"
                         Style="{StaticResource SettingsTextBoxStyle}"
                         Width="80"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         PreviewTextInput="DigitsOnly_PreviewTextInput"
                         LostFocus="ContextMenuFontSize_LostFocus"
                         KeyDown="ContextMenuFontSize_KeyDown"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="Appearance"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="Theme style"
                               Description="Follow Windows, or force light / dark mode for this app.">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="ThemeModeCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="ThemeMode" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="System">System</ComboBoxItem>
                    <ComboBoxItem Tag="Light">Light</ComboBoxItem>
                    <ComboBoxItem Tag="Dark">Dark</ComboBoxItem>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Text color"
                               Description="Override the default text color. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="TextColorLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="Text|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme text color"/>
                    <Button x:Name="TextColorDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="Text|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme text color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="Text" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Background color"
                               Description="Override the default background color. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="BackgroundColorLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="Background|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme background color"/>
                    <Button x:Name="BackgroundColorDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="Background|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme background color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="Background" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="Flyout"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="Rounded corners"
                               Description="Applies rounded corners to the flyout, settings cards, buttons, and menus. Turn off for a squared-off look.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="RoundedCornersToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="EnableRoundedCorners" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Slider indicator"
                               Description="The glyph drawn as the brightness-slider thumb. Each option keeps its own font family and size.">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="SliderThumbGlyphCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          SelectionChanged="SliderThumbGlyph_Changed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SliderThumbGlyphOption}">
                            <StackPanel Orientation="Horizontal"
                                        d:DataContext="{d:DesignInstance Type=models:SliderThumbGlyphOption}">
                                <Grid Width="22" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="{Binding FontFamily}"
                                               FontSize="{Binding FontSize}"
                                               Width="{Binding Width}"
                                               Height="{Binding Height}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Visibility="{Binding IsGlyph, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding XScale}" ScaleY="1"/>
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>
                                    <Border Width="{Binding Width}"
                                            Height="{Binding Height}"
                                            CornerRadius="{DynamicResource CornerRadiusCapsule}"
                                            Background="{DynamicResource ThemeForeground}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsCapsule, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="Tray icon"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="Tray icon style"
                               Description="Dynamic eclipses with brightness. Static locks the icon at 50% eclipse.">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayIconStyleCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayIconStyle" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="Dynamic">Eclipse (dynamic)</ComboBoxItem>
                    <ComboBoxItem Tag="Static">Eclipse (static)</ComboBoxItem>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Dynamic icon brightness tracking"
                               Description="How the dynamic tray icon reflects the individual monitor brightness values.">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="DynamicIconBrightnessTrackingCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="DynamicIconBrightnessTracking" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="Lowest">Lowest</ComboBoxItem>
                    <ComboBoxItem Tag="Average">Average</ComboBoxItem>
                    <ComboBoxItem Tag="Highest">Highest</ComboBoxItem>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Track only enabled monitor sliders"
                               Description="Exclude disabled monitors from the dynamic icon calculation. When all monitors are disabled, the icon shows full brightness.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="DynamicIconTrackEnabledOnlyToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="DynamicIconTrackEnabledOnly" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard x:Name="TrayIconStaticColorCard"
                               Title="Static icon color"
                               Description="Override the static tray icon color. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="TrayIconColorLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIcon|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme tray icon color"/>
                    <Button x:Name="TrayIconColorDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIcon|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme tray icon color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="TrayIcon" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard x:Name="TrayIconBrightColorCard"
                               Title="Bright color"
                               Description="Color used at 100% brightness. Blends toward the dim color as brightness decreases. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="TrayIconBrightColorLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIconBright|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme bright color"/>
                    <Button x:Name="TrayIconBrightColorDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIconBright|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme bright color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="TrayIconBright" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard x:Name="TrayIconDimColorCard"
                               Title="Dim color"
                               Description="Color used at 0% brightness. Blends toward the bright color as brightness increases. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="TrayIconDimColorLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIconDim|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme dim color"/>
                    <Button x:Name="TrayIconDimColorDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="TrayIconDim|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme dim color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="TrayIconDim" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="Environmental"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="Brightness curve color"
                               Description="Stroke color for the brightness curve and its legend swatch. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvBrightnessCurveLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvBrightnessCurve|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme brightness curve color"/>
                    <Button x:Name="EnvBrightnessCurveDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvBrightnessCurve|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme brightness curve color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="EnvBrightnessCurve" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Night light curve color"
                               Description="Stroke color for the night-light curve and its legend swatch. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvNightLightCurveLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvNightLightCurve|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme night-light curve color"/>
                    <Button x:Name="EnvNightLightCurveDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvNightLightCurve|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme night-light curve color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="EnvNightLightCurve" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Current-time marker color"
                               Description="Color of the dashed line marking the current time on the curve editor. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvCurrentTimeLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvCurrentTime|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme current-time marker color"/>
                    <Button x:Name="EnvCurrentTimeDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvCurrentTime|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme current-time marker color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="EnvCurrentTime" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Twilight backdrop color"
                               Description="Translucent band shaded behind the curves between sunrise/sunset and astronomical twilight. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvTwilightBackdropLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvTwilightBackdrop|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme twilight backdrop color"/>
                    <Button x:Name="EnvTwilightBackdropDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvTwilightBackdrop|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme twilight backdrop color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="EnvTwilightBackdrop" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Night backdrop color"
                               Description="Translucent band shaded behind the curves during astronomical night. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvNightBackdropLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvNightBackdrop|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme night backdrop color"/>
                    <Button x:Name="EnvNightBackdropDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvNightBackdrop|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme night backdrop color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="EnvNightBackdrop" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Grid line color"
                               Description="Color of the horizontal and vertical gridlines drawn behind the curves. Each variant falls back to the default when unset.">
            <utils:SettingsCard.Control>
                <StackPanel Style="{StaticResource SettingsCardControlPanel}">
                    <Button x:Name="EnvGridLineLightSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvGridLine|Light" Click="ColorSwatch_Click"
                            ToolTip="Light theme grid line color"/>
                    <Button x:Name="EnvGridLineDarkSwatch"
                            Style="{StaticResource ColorRowSwatchStyle}"
                            Tag="EnvGridLine|Dark" Click="ColorSwatch_Click"
                            ToolTip="Dark theme grid line color"/>
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="Reset"
                            Tag="EnvGridLine" Click="ColorReset_Click"/>
                </StackPanel>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>
    </StackPanel>
</UserControl>
