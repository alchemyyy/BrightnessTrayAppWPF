<UserControl
    x:Class="BrightnessTrayAppWPF.WPF.Settings.Pages.MonitorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BrightnessTrayAppWPF.WPF"
    xmlns:utils="clr-namespace:BrightnessTrayAppWPF.WPF.Settings.Utils"
    xmlns:pages="clr-namespace:BrightnessTrayAppWPF.WPF.Settings.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils1="clr-namespace:BrightnessTrayAppWPF.WPF.Utils"
    xmlns:addons="clr-namespace:BrightnessTrayAppWPF.WPF.Settings.Pages.MonitorsPageAddons"
    xmlns:loc="clr-namespace:BrightnessTrayAppWPF.Localization"
    mc:Ignorable="d"
    d:DesignWidth="660"
    d:DesignHeight="594"
    d:Background="#1F1F1F"
    utils1:SettingsKeyboardNavigation.IsContentSection="True">
    <UserControl.Resources>
        <!-- Per-monitor override row primitives.
             The MonitorListEntry DataTemplate stamps two four-column override rows per card;
             these styles centralize the row top margin, the inner-column gutter, and the
             label / spinner / textbox presets that the card duplicates across all overrides. -->

        <Style x:Key="MonitorOverrideRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="MonitorOverrideFieldColumnStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="MonitorOverrideLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SettingDescriptionStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MonitorOverrideDwellSpinnerStyle" TargetType="local:NumericSpinner">
            <Setter Property="Suffix" Value="{loc:Loc Settings_Monitors_Milliseconds_Suffix}"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="10000"/>
            <Setter Property="WheelStep" Value="10"/>
            <Setter Property="AllowInherit" Value="True"/>
        </Style>

        <Style x:Key="MonitorOverrideBrightnessSpinnerStyle" TargetType="local:NumericSpinner">
            <Setter Property="Suffix" Value="{loc:Loc Settings_Monitors_Percent_Suffix}"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="WheelStep" Value="5"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc Settings_Monitors_SectionHeader}"/>

        <utils:SettingsCard Title="{loc:Loc Settings_Monitors_BrightnessRate_Title}"
                               Description="{loc:Loc Settings_Monitors_BrightnessRate_Description}">
            <utils:SettingsCard.Control>
                <local:NumericSpinner Style="{StaticResource DwellTimeSpinnerStyle}"
                                      x:Name="BrightnessRateBox"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Monitors_ValidationDwell_Title}"
                               Description="{loc:Loc Settings_Monitors_ValidationDwell_Description}">
            <utils:SettingsCard.Control>
                <local:NumericSpinner Style="{StaticResource DwellTimeSpinnerStyle}"
                                      x:Name="ValidationDwellBox"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Monitors_ValidationAttempts_Title}"
                               Description="{loc:Loc Settings_Monitors_ValidationAttempts_Description}">
            <utils:SettingsCard.Control>
                <local:NumericSpinner Width="100" VerticalAlignment="Center"
                                      x:Name="ValidationAttemptsBox"
                                      Minimum="1" Maximum="10"
                                      WheelStep="10"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Monitors_DDCOperationTimeout_Title}"
                               Description="{loc:Loc Settings_Monitors_DDCOperationTimeout_Description}">
            <utils:SettingsCard.Control>
                <local:NumericSpinner Style="{StaticResource DwellTimeSpinnerStyle}"
                                      x:Name="DDCOperationTimeoutBox"
                                      Maximum="15000"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Monitors_PowerOffMode_Title}"
                               Description="{loc:Loc Settings_Monitors_PowerOffMode_Description}">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="PowerOffModeCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="PowerOffMode" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="Sleep" Content="{loc:Loc Settings_Monitors_PowerOff_Sleep}"/>
                    <ComboBoxItem Tag="Soft" Content="{loc:Loc Settings_Monitors_PowerOff_Soft}"/>
                    <ComboBoxItem Tag="Hard" Content="{loc:Loc Settings_Monitors_PowerOff_Hard}"/>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Monitors_IdentityStrategy_Title}"
                               Description="{loc:Loc Settings_Monitors_IdentityStrategy_Description}">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="IdentityStrategyCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="MonitorIdentityStrategy" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="DisplayNumber" Content="{loc:Loc Settings_Monitors_Identity_DisplayNumber}"/>
                    <ComboBoxItem Tag="HardwarePort" Content="{loc:Loc Settings_Monitors_Identity_HardwarePort}"/>
                    <ComboBoxItem Tag="EDIDSerial" Content="{loc:Loc Settings_Monitors_Identity_EDIDSerial}"/>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="{loc:Loc Settings_Monitors_DefaultSort_Title}"
                               Description="{loc:Loc Settings_Monitors_DefaultSort_Description}">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="DefaultSortCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          SelectionChanged="DefaultSort_Changed">
                    <ComboBoxItem Tag="Arrangement" Content="{loc:Loc Settings_Monitors_Sort_Arrangement}"/>
                    <ComboBoxItem Tag="ArrangementRev" Content="{loc:Loc Settings_Monitors_Sort_ArrangementRev}"/>
                    <ComboBoxItem Tag="DisplayNumber" Content="{loc:Loc Settings_Monitors_Sort_DisplayNumber}"/>
                    <ComboBoxItem Tag="DisplayNumberRev" Content="{loc:Loc Settings_Monitors_Sort_DisplayNumberRev}"/>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <Grid Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource SettingsCardTitlePanel}">
                <TextBlock Text="{loc:Loc Settings_Monitors_DisplayOrder_Title}"
                           Style="{StaticResource SettingTitleStyle}"
                           FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                           Text="{loc:Loc Settings_Monitors_DisplayOrder_Description}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="ClearDisplaysButton"
                    Style="{StaticResource SettingsButtonStyle}"
                    Content="{loc:Loc Settings_Monitors_ClearDisplays_Button}"
                    VerticalAlignment="Center"
                    Margin="{StaticResource RightSpacerSmall}"
                    Click="ClearDisplays_Click"/>
            <Button Grid.Column="2"
                    x:Name="IdentifyDisplaysButton"
                    Style="{StaticResource SettingsButtonStyle}"
                    Content="{loc:Loc Settings_Monitors_IdentifyDisplays_Button}"
                    VerticalAlignment="Center"
                    Click="IdentifyDisplays_Click"/>
        </Grid>

        <ItemsControl x:Name="MonitorListPanel">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:MonitorListEntry}">
                    <Grid d:DataContext="{d:DesignInstance Type=pages:MonitorListEntry}">
                        <Border x:Name="DragCardContent"
                                Style="{StaticResource SettingsCardStyle}"
                                Padding="10,12"
                                IsEnabled="{Binding IsActive}"
                                Tag="{Binding EDIDKey}"
                                PreviewKeyDown="MonitorCard_PreviewKeyDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Badge column.
                                     Active rows show the OS display number;
                                     inactive rows leave the badge blank but widen the slot
                                     so the row's title clears the delete button
                                     (which overlays the card top-left). -->
                                <Border Grid.Column="0"
                                        Background="Transparent"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Width" Value="20"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                                    <Setter Property="Width" Value="32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DisplayNumberLabel}"
                                               Foreground="{DynamicResource ThemeForeground}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <!-- Original name (plain text) + Name override box.
                                         Mirrors the column layout of the override rows below
                                         so the TextBox lines up with their fourth column. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Grid.Column="0" Grid.ColumnSpan="3" LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{loc:Loc Settings_Monitors_Name_Label}"
                                                       Style="{StaticResource SettingDescriptionStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Foreground="{DynamicResource ThemeForeground}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,12,0">
                                                <Run Text="{Binding OriginalNameDisplay, Mode=OneWay}"/><Run Text="{Binding EDIDSuffix, Mode=OneWay}"
                                                                                                            Foreground="{DynamicResource ThemeSecondaryForeground}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBox Grid.Column="3"
                                                 Style="{StaticResource SettingsTextBoxStyle}"
                                                 Text="{Binding NameOverride, UpdateSourceTrigger=LostFocus}"
                                                 VerticalAlignment="Center"
                                                 LostFocus="MonitorName_LostFocus"
                                                 Tag="{Binding EDIDKey}"
                                                 utils1:WatermarkBehavior.Text="{Binding NamePlaceholder}"
                                                 Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- Override row 1:
                                         Min brightness, Max brightness, Validation dwell, Brightness dwell.
                                         Inner-only right margin on cols 0 / 1 / 2 keeps a 12px gutter without
                                         stacking adjacent margins (which previously summed to 12). -->
                                    <Grid Style="{StaticResource MonitorOverrideRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Style="{StaticResource MonitorOverrideFieldColumnStyle}">
                                            <TextBlock Text="{loc:Loc Settings_Monitors_MinBrightnessOverride_Label}" Style="{StaticResource MonitorOverrideLabelStyle}"/>
                                            <local:NumericSpinner Style="{StaticResource MonitorOverrideBrightnessSpinnerStyle}"
                                                                  Value="{Binding MinBrightnessOverride, UpdateSourceTrigger=PropertyChanged}"
                                                                  Tag="MinBrightness"
                                                                  AllowInherit="True"
                                                                  InheritValue="0"
                                                                  PlaceholderText="0"
                                                                  Loaded="MonitorOverrideSpinner_Loaded"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Style="{StaticResource MonitorOverrideFieldColumnStyle}">
                                            <TextBlock Text="{loc:Loc Settings_Monitors_MaxBrightnessOverride_Label}" Style="{StaticResource MonitorOverrideLabelStyle}"/>
                                            <local:NumericSpinner Style="{StaticResource MonitorOverrideBrightnessSpinnerStyle}"
                                                                  Value="{Binding MaxBrightnessOverride, UpdateSourceTrigger=PropertyChanged}"
                                                                  Tag="MaxBrightness"
                                                                  AllowInherit="True"
                                                                  InheritValue="100"
                                                                  PlaceholderText="100"
                                                                  Loaded="MonitorOverrideSpinner_Loaded"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Style="{StaticResource MonitorOverrideFieldColumnStyle}">
                                            <TextBlock Text="{loc:Loc Settings_Monitors_ValidationDwellOverride_Label}" Style="{StaticResource MonitorOverrideLabelStyle}"/>
                                            <local:NumericSpinner Style="{StaticResource MonitorOverrideDwellSpinnerStyle}"
                                                                  Value="{Binding ValidationDwellOverride, UpdateSourceTrigger=PropertyChanged}"
                                                                  Tag="ValidationDwell"
                                                                  PlaceholderText="{Binding ValidationDwellPlaceholder}"
                                                                  Loaded="MonitorOverrideSpinner_Loaded"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{loc:Loc Settings_Monitors_BrightnessDwellOverride_Label}" Style="{StaticResource MonitorOverrideLabelStyle}"/>
                                            <local:NumericSpinner Style="{StaticResource MonitorOverrideDwellSpinnerStyle}"
                                                                  Value="{Binding BrightnessDwellOverride, UpdateSourceTrigger=PropertyChanged}"
                                                                  Tag="BrightnessDwell"
                                                                  PlaceholderText="{Binding BrightnessDwellPlaceholder}"
                                                                  Loaded="MonitorOverrideSpinner_Loaded"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Override row 2:
                                         Edit norm curve button, then Power off / Brightness inc / dec VCP textboxes.
                                         Each textbox accepts "0xD6 0x05" (byte + value) or "0xD6" (byte only,
                                         backend uses default values). Empty = inherit profile default.
                                         Button is vertically centered to balance against the label+textbox columns. -->
                                    <Grid Style="{StaticResource MonitorOverrideRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Margin="0,0,12,0">
                                            <Button Style="{StaticResource SettingsButtonStyle}"
                                                    Content="{loc:Loc Settings_Monitors_EditNormCurve_Button}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Bottom"
                                                    Height="32"
                                                    Tag="{Binding EDIDKey}"
                                                    Click="EditNormCurve_Click"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Style="{StaticResource MonitorOverrideFieldColumnStyle}">
                                            <TextBlock Text="{loc:Loc Settings_Monitors_PowerOffVcpOverride_Label}" Style="{StaticResource MonitorOverrideLabelStyle}"/>
                                            <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                                     Text="{Binding PowerOffVcpOverride, Mode=OneWay}"
                                                     Tag="PowerOffVcp"
                                                     LostFocus="MonitorVcpOverride_LostFocus"
                                                     utils1:WatermarkBehavior.Text="{Binding PowerOffVcpPlaceholder}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Style="{StaticResource MonitorOverrideFieldColumnStyle}">
                                            <TextBlock Text="{loc:Loc Settings_Monitors_BrightnessVcpOverride_Label}" Style="{StaticResource MonitorOverrideLabelStyle}"/>
                                            <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                                                     Text="{Binding BrightnessVcpOverride, Mode=OneWay}"
                                                     Tag="BrightnessVcp"
                                                     LostFocus="MonitorVcpOverride_LostFocus"
                                                     utils1:WatermarkBehavior.Text="{Binding BrightnessVcpPlaceholder}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Per-row norm curve editor.
                                         Toggled by the "Edit norm curve" button via IsNormCurveEditorOpen on the
                                         MonitorListEntry; collapsed by default so the card stays compact until the
                                         user opts in. Each row stamps its own editor instance (DataTemplate),
                                         so handing the row's live point list to SetPoints in Loaded keeps storage
                                         and editor pointing at the same list. -->
                                    <addons:NormCurveEditor Height="220"
                                                            Margin="0,12,0,0"
                                                            Loaded="NormCurveEditor_Loaded"
                                                            Visibility="{Binding IsNormCurveEditorOpen,
                                                                Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        Margin="8,0,0,0"
                                        Width="28"
                                        VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="Gripper_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="Gripper_PreviewMouseMove"
                                        Tag="{Binding EDIDKey}"
                                        ToolTip="{loc:Loc Settings_Monitors_DragToReorder_Tooltip}">
                                    <TextBlock Text="&#xE784;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="16"
                                               Foreground="{DynamicResource ThemeForeground}"
                                               Opacity="0.7"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Rectangle x:Name="DragSlotCover"
                                   Fill="{DynamicResource ThemeBackground}"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"/>
                        <!-- Delete button - visible only on disconnected (inactive) cards.
                             Lives outside DragCardContent so its IsEnabled isn't suppressed
                             by the inactive-card dim cascade. -->
                        <Button Width="30"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6,6,0,0"
                                Style="{StaticResource SettingsButtonStyle}"
                                Padding="0"
                                Content="&#xE894;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="11"
                                Tag="{Binding EDIDKey}"
                                ToolTip="{loc:Loc Settings_Monitors_DeleteSavedDisplay_Tooltip}"
                                Visibility="{Binding IsInactive, Converter={StaticResource BoolToVisibility}}"
                                Click="DeleteInactiveDisplay_Click"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
