<UserControl
    x:Class="BrightnessTrayAppWpf.Wpf.Settings.Pages.EnvironmentalPageAddons.CurveEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="clr-namespace:BrightnessTrayAppWpf.Wpf.Utils"
    Background="Transparent"
    Focusable="True"
    IsTabStop="True"
    utils:SettingsKeyboardNavigation.IsKeyboardCapture="True"
    PreviewKeyDown="OnPreviewKeyDown"
    GotKeyboardFocus="OnGotKeyboardFocus"
    LostKeyboardFocus="OnLostKeyboardFocus">

    <Border CornerRadius="{DynamicResource CornerRadiusLarge}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Y-axis label gutters flank the plot. Both are tight against the plot column
                     — labels right-align inside the left gutter and left-align inside the right gutter
                     so each value sits as close to its gridline as possible. -->
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>

            <!-- Y-axis labels on the left, right-aligned so they hug the plot's edge. -->
            <Canvas x:Name="ValueLabelCanvas"
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    SnapsToDevicePixels="True"/>

            <!-- Plot area: hosts grid lines, polylines, and control-point thumbs.
                 SizeChanged drives a redraw so the curves rescale with the tab. -->
            <Canvas x:Name="PlotCanvas"
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Transparent"
                    SnapsToDevicePixels="True"
                    ClipToBounds="False"
                    SizeChanged="PlotCanvas_SizeChanged"
                    MouseLeftButtonDown="PlotCanvas_MouseLeftButtonDown"
                    MouseRightButtonDown="PlotCanvas_MouseRightButtonDown"
                    MouseMove="PlotCanvas_MouseMove"
                    MouseLeftButtonUp="PlotCanvas_MouseLeftButtonUp"
                    MouseEnter="PlotCanvas_MouseEnter"
                    MouseLeave="PlotCanvas_MouseLeave"/>

            <!-- Cursor-readout overlay layer. Holds persistent elements
                 (scrubber line, readout text, per-curve markers, legend pill)
                 whose positions are mutated directly without touching the heavy Redraw path.
                 Hit-test transparent so input falls through to PlotCanvas underneath. -->
            <Canvas x:Name="OverlayCanvas"
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Transparent"
                    SnapsToDevicePixels="True"
                    ClipToBounds="True"
                    IsHitTestVisible="False"/>

            <!-- Y-axis labels mirrored on the right side, left-aligned against the plot edge. -->
            <Canvas x:Name="ValueLabelCanvasRight"
                    Grid.Row="0"
                    Grid.Column="2"
                    Background="Transparent"
                    SnapsToDevicePixels="True"/>

            <!-- Hour labels strip (00, 06, 12, 18, 24) — one entry per major gridline.
                 Sits below the plot so the labels don't crowd the curves. -->
            <Canvas x:Name="HourLabelCanvas"
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="Transparent"
                    SnapsToDevicePixels="True"/>

            <!-- Preview-mode tint: a subtle desaturating wash over the entire editor chrome
                 so it's visually obvious the curve is non-interactive.
                 Hit-test transparent so any input that does sneak through still goes to the PlotCanvas
                 (which guards itself in code). Toggled from SetPreviewMode. -->
            <Rectangle x:Name="PreviewTintOverlay"
                       Grid.Row="0" Grid.RowSpan="2"
                       Grid.Column="0" Grid.ColumnSpan="3"
                       Fill="#FFFFFFFF"
                       Opacity="0.06"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>

            <!-- Exit Preview Mode button: anchored bottom-right of the plot cell.
                 Visible only while the editor is in preview mode.
                 Click bubbles out through the ExitPreviewModeRequested event so the host can clear the preview date.
                 Self-contained template so the editor doesn't depend on settings-window theme resources. -->
            <Button x:Name="ExitPreviewButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,12,12"
                    Padding="10,4"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    Background="#CC2A2A2A"
                    Foreground="White"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    Content="Exit Preview Mode"
                    Click="ExitPreviewButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E03A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F1F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
