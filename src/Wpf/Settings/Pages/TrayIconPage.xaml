<UserControl
    x:Class="BrightnessTrayAppWpf.Wpf.Settings.Pages.TrayIconPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:BrightnessTrayAppWpf.Wpf.Settings.Utils"
    xmlns:utils1="clr-namespace:BrightnessTrayAppWpf.Wpf.Utils"
    mc:Ignorable="d"
    d:DesignWidth="660"
    d:DesignHeight="594"
    d:Background="#1F1F1F"
    utils1:SettingsKeyboardNavigation.IsContentSection="True">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Tray Icon"/>

        <utils:SettingsCard Title="Mouse wheel"
                               Description="Enable scrolling the mouse wheel while hovering the tray icon. Configure targets below in 'Modified actions'. Does *not* use an always-active global mouse hook.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="TrayScrollEnableToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="TrayScrollEnabled" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="Context menu"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <utils:SettingsCard Title="Show profile selectors"
                               Description="Display brightness profile entries in the tray right-click menu.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowProfileSelectorsToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowProfileSelectorsInMenu" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Show individual power selectors"
                               Description="Display per-monitor power toggles in the tray right-click menu.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowMonitorPowerToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowMonitorPowerButtons" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Show all-displays power selector"
                               Description="Display a single entry that powers every display off.">
            <utils:SettingsCard.Control>
                <CheckBox x:Name="ShowAllDisplaysPowerToggle"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Tag="ShowAllDisplaysPowerButton" Checked="BoolToggle_Changed"
                          Unchecked="BoolToggle_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Menu position"
                               Description="Classic opens at the cursor. Modern docks the menu above the taskbar like the Windows 11 system flyouts.">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="ContextMenuPositionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="ContextMenuPosition" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="Classic">Classic</ComboBoxItem>
                    <ComboBoxItem Tag="Modern">Modern</ComboBoxItem>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <TextBlock Text="Modified actions"
                   Style="{StaticResource SubsectionHeaderStyle}"/>
        <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                   Text="Assign actions to modified clicks or scrolls on the tray icon. Entries set to Nothing fall back to the default behavior."
                   Margin="0,0,0,8"/>

        <utils:SettingsCard Title="Mouse wheel"
                               IsEnabled="{Binding IsChecked, ElementName=TrayScrollEnableToggle}">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayWheelActionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayWheelAction" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="Nothing">Nothing</ComboBoxItem>
                    <ComboBoxItem Tag="Brightness">Brightness</ComboBoxItem>
                    <ComboBoxItem Tag="NightLight">Night Light</ComboBoxItem>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Ctrl + mouse wheel"
                               IsEnabled="{Binding IsChecked, ElementName=TrayScrollEnableToggle}">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayCtrlWheelActionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayCtrlWheelAction" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="Nothing">Nothing</ComboBoxItem>
                    <ComboBoxItem Tag="Brightness">Brightness</ComboBoxItem>
                    <ComboBoxItem Tag="NightLight">Night Light</ComboBoxItem>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Alt + mouse wheel"
                               IsEnabled="{Binding IsChecked, ElementName=TrayScrollEnableToggle}">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayAltWheelActionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayAltWheelAction" SelectionChanged="EnumCombo_Changed">
                    <ComboBoxItem Tag="Nothing">Nothing</ComboBoxItem>
                    <ComboBoxItem Tag="Brightness">Brightness</ComboBoxItem>
                    <ComboBoxItem Tag="NightLight">Night Light</ComboBoxItem>
                </ComboBox>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Ctrl + left click">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayCtrlLeftClickActionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayCtrlLeftClickAction" SelectionChanged="EnumCombo_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Alt + left click">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayAltLeftClickActionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayAltLeftClickAction" SelectionChanged="EnumCombo_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Ctrl + right click">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayCtrlRightClickActionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayCtrlRightClickAction" SelectionChanged="EnumCombo_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Alt + right click">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayAltRightClickActionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayAltRightClickAction" SelectionChanged="EnumCombo_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Double left click">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayDoubleClickActionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayDoubleClickAction" SelectionChanged="EnumCombo_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Ctrl + double left click">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayCtrlDoubleLeftClickActionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayCtrlDoubleLeftClickAction" SelectionChanged="EnumCombo_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>

        <utils:SettingsCard Title="Alt + double left click">
            <utils:SettingsCard.Control>
                <ComboBox x:Name="TrayAltDoubleLeftClickActionCombo"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          VerticalAlignment="Center"
                          Tag="TrayAltDoubleLeftClickAction" SelectionChanged="EnumCombo_Changed"/>
            </utils:SettingsCard.Control>
        </utils:SettingsCard>
    </StackPanel>
</UserControl>
