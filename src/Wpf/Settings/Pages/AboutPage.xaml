<UserControl
    x:Class="BrightnessTrayAppWpf.Wpf.Settings.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:BrightnessTrayAppWpf.Wpf.Utils"
    mc:Ignorable="d"
    d:DesignWidth="660"
    d:DesignHeight="594"
    d:Background="#1F1F1F"
    utils:SettingsKeyboardNavigation.IsContentSection="True">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="About"/>

        <TextBlock Text="BrightnessTrayAppWpf"
                   FontSize="14"
                   FontWeight="Normal"
                   Foreground="{DynamicResource ThemeForeground}"
                   Margin="0,0,0,4"/>

        <TextBlock Text="A tray-based brightness controller for DDC/CI monitors."
                   Foreground="{DynamicResource ThemeForeground}"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,24"/>

        <StackPanel Orientation="Horizontal" Margin="{StaticResource AboutRowMargin}">
            <TextBlock Text="Build"
                       Style="{StaticResource AboutLabelStyle}"/>
            <TextBlock x:Name="BuildNumberText"
                       Foreground="{DynamicResource ThemeForeground}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="{StaticResource AboutRowMargin}">
            <TextBlock Text="Runtime"
                       Style="{StaticResource AboutLabelStyle}"/>
            <TextBlock x:Name="RuntimeText"
                       Foreground="{DynamicResource ThemeForeground}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="{StaticResource AboutRowMargin}">
            <TextBlock Text="Author"
                       Style="{StaticResource AboutLabelStyle}"/>
            <TextBlock Text="alchemyyy"
                       Foreground="{DynamicResource ThemeForeground}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="{StaticResource AboutRowMargin}">
            <TextBlock Text="Github"
                       Style="{StaticResource AboutLabelStyle}"/>
            <TextBlock>
                <Hyperlink NavigateUri="https://github.com/alchemyyy/BrightnessTrayAppWpf"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Foreground="{DynamicResource ThemeForeground}">
                    <Run Text="https://github.com/alchemyyy/BrightnessTrayAppWpf"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBlock Text="Known Issues"
                   Style="{StaticResource SubsectionHeaderStyle}"/>

        <Border Style="{StaticResource SettingsCardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Night Light corruption"/>
            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                       Text="If Night Light becomes unresponsive, win+alt+shift+b then signing out and back in should clear it."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="DDC state corruption"/>
            <TextBlock Style="{StaticResource SettingDescriptionStyle}"
                       Text="If a monitor becomes unrecoverable, its slider will show with a warning triangle glyph. The monitor will have to be power cycled to restore DDC."/>
          </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
